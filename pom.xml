<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>design.knowledge.stamp</groupId>
    <artifactId>stamp-adoc-explorer</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>stamp-adoc-explorer</name>
    <description>
        Private incubator for the ike-git STAMP extraction capability and its
        surfaces: the extraction engine (core), a JavaFX RichTextArea
        visualization (fx), and an IntelliJ gutter plugin (idea).
        Tracks IKE-Network/ike-issues#468.
    </description>

    <modules>
        <module>core</module>
        <module>idea</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The engine and the plugin compile for 21 so the plugin loads on
             any JetBrains Runtime since 2024; only the JavaFX surface
             raises the level. -->
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.version>26</javafx.version>
        <!-- JGit as the JPMS-wrapped module the Komet runtime ships (dev.ikm.jpms.jgit@7.2.0,
             komet-bom's jgit.version), so the core resolves against the same module in Komet's boot layer and nothing
             arrives as an automatic module. RoaringBitmap likewise tracks the runtime's line. -->
        <jgit.version>7.2.0.202503040940-r-r5</jgit.version>
        <roaringbitmap.version>1.6.9</roaringbitmap.version>
        <slf4j.version>1.7.36</slf4j.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.ikm.jpms</groupId>
                <artifactId>jgit</artifactId>
                <version>${jgit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.roaringbitmap</groupId>
                <artifactId>RoaringBitmap</artifactId>
                <version>${roaringbitmap.version}</version>
            </dependency>
            <!-- JGit logs through SLF4J 1.7; the no-op binding keeps the
                 headless surfaces quiet. The IDE supplies its own binding. -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-nop</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.7.1</version>
                </plugin>
                <plugin>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-maven-plugin</artifactId>
                    <version>0.0.8</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
